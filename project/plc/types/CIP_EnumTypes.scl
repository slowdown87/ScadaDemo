// ============================================================================
// CIP清洗系统 - 枚举类型定义
// ============================================================================
// 适用于: S7-1500 (TIA Portal V17)
// 版本: v1.0
// ============================================================================

// ---------------------------------------------------------------------------
// 1.1 清洗介质类型
// ---------------------------------------------------------------------------
TYPE "Enum_MediaType"
    // 冲洗介质
    PURE_WATER := 0,    // 纯水冲洗
    // 化学清洗介质
    ALKALI     := 1,    // 碱洗 (2% NaOH, 85℃)
    ACID       := 2,    // 酸洗 (1% HNO3, 60℃)
    HOT_WATER  := 3,    // 热水洗 (85℃)
    DISINFECT  := 4,    // 消毒液 (0.5%)
END_TYPE

// ---------------------------------------------------------------------------
// 1.2 清洗状态
// ---------------------------------------------------------------------------
TYPE "Enum_CleanState"
    IDLE             := 0,   // 待机
    READY            := 1,   // 准备就绪
    STEP_EXEC        := 2,   // 步骤执行中
    STEP_TRANSITION  := 3,   // 步骤切换中
    COMPLETE         := 4,   // 清洗完成
    PAUSE            := 5,   // 暂停
    FAULT            := 6,   // 故障
END_TYPE

// ---------------------------------------------------------------------------
// 1.3 报警等级
// ---------------------------------------------------------------------------
TYPE "Enum_AlarmLevel"
    L0_CRITICAL := 0,    // 严重 - 急停、泵过载
    L1_WARNING  := 1,    // 警告 - 温度不达标、无流量
    L2_INFO     := 2,    // 提示 - 液位低
END_TYPE

// ---------------------------------------------------------------------------
// 1.4 就地/远程选择
// ---------------------------------------------------------------------------
TYPE "Enum_HandsMode"
    LOCAL  := 0,    // 就地
    REMOTE := 1,    // 远程
END_TYPE

// ---------------------------------------------------------------------------
// 1.5 阀门状态
// ---------------------------------------------------------------------------
TYPE "Enum_ValveState"
    VALVE_CLOSED := 0,
    VALVE_OPEN   := 1,
    VALVE_FAULT  := 2,
END_TYPE

// ---------------------------------------------------------------------------
// 1.6 泵状态
// ---------------------------------------------------------------------------
TYPE "Enum_PumpState"
    PUMP_STOP    := 0,
    PUMP_RUN     := 1,
    PUMP_FAULT   := 2,
    PUMP_WARNING := 3,
END_TYPE

// ---------------------------------------------------------------------------
// 1.7 控制命令
// ---------------------------------------------------------------------------
TYPE "Enum_ControlCmd"
    CMD_NONE     := 0,   // 无命令
    CMD_START    := 1,   // 启动清洗
    CMD_STOP     := 2,   // 停止清洗
    CMD_PAUSE    := 3,   // 暂停
    CMD_RESUME   := 4,   // 恢复
    CMD_RESET    := 5,   // 复位/清除故障
END_TYPE
