// ============================================================================
// CIP清洗系统 - 全局数据块定义
// ============================================================================
// 适用于: S7-1500 (TIA Portal V17)
// 版本: v1.0
// 说明: 本文件定义全局数据块结构，在TIA Portal中创建实际的DB块
// ============================================================================

// ---------------------------------------------------------------------------
// 全局变量声明模板
// 在TIA Portal中创建全局数据块，使用以下结构
// ---------------------------------------------------------------------------
/*
DATA_BLOCK "Global_Data"
TITLE = "全局数据"
AUTHOR : "SCADA"
VERSION : "1.0"
NON_RETAIN
STRUCT

    // ========== 系统状态 ==========
    System : "UDT_SystemStatus";

    // ========== 阀门状态 ==========
    Valve : STRUCT
        // 公用介质阀门
        Alkali      : Bool;           // 碱液阀
        Acid        : Bool;           // 酸液阀
        HotWater    : Bool;           // 热水阀
        PureWater   : Bool;           // 纯水阀
        Disinfect   : Bool;           // 消毒阀
        Drain       : Bool;           // 排放阀
        Circulate   : Bool;           // 循环阀
        // 分区阀门数组 (5区 x 5阀 = 25个)
        // 每区: 进液(Zx-V-01)、回流(Zx-V-02)、排放(Zx-V-03)、循环(Zx-V-04)、介质(Zx-V-05)
        ZoneValve   : Array[1..25] of Bool;
    END_STRUCT

    // ========== 温度PID参数 ==========
    PID_Temp : Array[1..5] of "UDT_PIDParams";

    // ========== 流量PID参数 ==========
    PID_Flow : Array[1..5] of "UDT_PIDParams";

    // ========== 介质状态 ==========
    MediaAlkali     : "UDT_MediaStatus";   // 碱液
    MediaAcid       : "UDT_MediaStatus";   // 酸液
    MediaHotWater   : "UDT_MediaStatus";   // 热水
    MediaPureWater  : "UDT_MediaStatus";   // 纯水
    MediaDisinfect  : "UDT_MediaStatus";   // 消毒液

    // ========== 罐区状态 ==========
    TankAlkali     : "UDT_TankStatus";   // 碱液罐
    TankAcid       : "UDT_TankStatus";   // 酸液罐
    TankHotWater   : "UDT_TankStatus";   // 热水罐
    TankPureWater  : "UDT_TankStatus";   // 纯水罐

    // ========== 报警 ==========
    AlarmActive : Array[1..50] of "UDT_AlarmInfo";
    AlarmCount  : Int;

    // ========== 历史记录 ==========
    History      : Array[1..100] of "UDT_HistoryRecord";
    HistoryWriteIndex : Int := 1;
    HistoryCount : Int := 0;

    // ========== 配方 ==========
    RecipeList : Array[1..10] of "UDT_RecipeData";

    // ========== 输出命令 ==========
    Output : STRUCT
        PumpCmd     : Bool;
        SteamValve  : Int;
        Buzzer      : Bool;
    END_STRUCT

    // ========== 模拟输入(实际从硬件读取) ==========
    AI_TT_Outlet   : Array[1..5] of Real;    // 出口温度
    AI_TT_Return   : Array[1..5] of Real;     // 回流温度
    AI_Conductivity : Array[1..5] of Real;    // 电导率
    AI_Pressure    : Array[1..5] of Real;     // 管路压力
    AI_Flow        : Array[1..5] of Real;     // 清洗流量

    // ========== 数字输入 ==========
    DI_FlowSwitch    : Array[1..5] of Bool;  // 流动开关
    DI_PumpOverload   : Array[1..5] of Bool;  // 泵过载

END_STRUCT
END_DATA_BLOCK
*/

// ---------------------------------------------------------------------------
// 区域数据块模板 (5个区各自独立)
// ---------------------------------------------------------------------------
/*
// 区域1数据块
DATA_BLOCK "DB_Zone1"
TITLE = "1区状态数据"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_GLOBAL
    Zone : "UDT_ZoneData";
END_VAR
END_DATA_BLOCK

// 区域2-5类似...
*/

// ============================================================================
// 常量定义
// ============================================================================

// ---------------------------------------------------------------------------
// 4.1 报警代码定义
// ---------------------------------------------------------------------------
//| 报警号 | 描述                      | 等级 |
//|--------|--------------------------|------|
//| CP-001 | 碱液罐液位低              | L2   |
//| CP-002 | 酸液罐液位低              | L2   |
//| CP-003 | 热水罐液位低              | L2   |
//| CP-004 | 纯水罐液位低              | L2   |
//| CP-005 | 清洗温度不达标            | L1   |
//| CP-006 | 电导率超标                | L1   |
//| CP-008 | 管路压力异常              | L2   |
//| CP-009 | 清洗泵过载                | L0   |
//| CP-012~016 | 1-5区无流量        | L1   |
//| CP-017 | 急停触发                  | L0   |
//| CP-018 | 清洗序列非法              | L1   |
//| CP-030 | 温差>20℃(警告)           | L2   |
//| CP-031 | 温差>30℃(报警)           | L1   |
//| CP-032 | 返回温度过高              | L1   |
//| CP-033 | 温度传感器故障            | L1   |

// ---------------------------------------------------------------------------
// 4.2 时间常量
// ---------------------------------------------------------------------------
//| 常量名称        | 值(秒) | 说明 |
//|----------------|--------|------|
//| NO_FLOW_TIMEOUT | 30     | 无流量超时 |
//| TEMP_LOW_TIMEOUT | 300  | 低温超时(5分钟) |
//| DEFAULT_RINSE_TIME | 300 | 默认冲洗时间(5分钟) |
//| MAX_STEP_TIME | 7200    | 最大步骤时间(2小时) |

// ---------------------------------------------------------------------------
// 4.3 设备参数常量
// ---------------------------------------------------------------------------
//| 常量名称        | 值     | 说明 |
//|----------------|--------|------|
//| MAX_FLOW_RATE  | 6.0    | 泵最大流量 (m³/h) |
//| DEFAULT_FLOW   | 3.0    | 默认清洗流量 (m³/h) |
//| PUMP_MIN_SPEED | 0.0    | 泵最小速度 (%) |
//| PUMP_MAX_SPEED | 100.0  | 泵最大速度 (%) |
