// ============================================================================
// CIP清洗系统 - 系统功能
// ============================================================================
// 适用于: S7-1500 (TIA Portal V17)
// 版本: v1.0
// ============================================================================


// ============================================================================
// FC_EmergencyStop : 急停处理
// ============================================================================
FUNCTION "FC_EmergencyStop" : Void
TITLE = "急停处理"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_TEMP
    i : Int;
END_VAR

    // 停止所有泵
    FOR i := 1 TO 5 DO
        "DB_Zone"[i].PumpCmd := FALSE;
    END_FOR;

    // 关闭所有阀门
    "Global".Valve.Alkali := FALSE;
    "Global".Valve.Acid := FALSE;
    "Global".Valve.HotWater := FALSE;
    "Global".Valve.PureWater := FALSE;
    "Global".Valve.Disinfect := FALSE;
    "Global".Valve.Drain := FALSE;
    "Global".Valve.Circulate := FALSE;

    // 关闭蒸汽阀
    "Global".Output.SteamValve := 0;

    // 所有区域进入故障状态
    FOR i := 1 TO 5 DO
        "DB_Zone"[i].State := "Enum_CleanState".FAULT;
    END_FOR;

    // 触发急停报警
    "Global".System.EStop := TRUE;
    "Global".AlarmCount := "Global".AlarmCount + 1;
    "Global".AlarmActive[1].AlarmID := 17;  // CP-017
    "Global".AlarmActive[1].Level := "Enum_AlarmLevel".L0_CRITICAL;
    "Global".AlarmActive[1].TriggerTime := "Global".System.SystemTime;

    // 系统未就绪
    "Global".System.SystemReady := FALSE;

END_FUNCTION


// ============================================================================
// FC_InitGlobalData : 初始化全局数据
// ============================================================================
FUNCTION "FC_InitGlobalData" : Void
TITLE = "初始化全局数据"
AUTHOR : "SCADA"
VERSION : "1.0"

    // 系统状态
    "Global".System.HandsMode := "Enum_HandsMode".REMOTE;
    "Global".System.AutoMode := TRUE;
    "Global".System.ManualMode := FALSE;
    "Global".System.SystemReady := FALSE;
    "Global".System.EStop := FALSE;
    "Global".System.Running := FALSE;
    "Global".System.AllIdle := TRUE;
    "Global".System.PLCConnected := TRUE;
    "Global".System.HMIConnected := TRUE;
    "Global".System.ActiveZones := 0;
    "Global".System.AlarmCount := 0;
    "Global".System.QueueCount := 0;

    // 初始化介质状态
    "Global".MediaAlkali.InUse := FALSE;
    "Global".MediaAlkali.UsingZone := 0;
    "Global".MediaAlkali.QueueCount := 0;
    "Global".MediaAcid.InUse := FALSE;
    "Global".MediaAcid.UsingZone := 0;
    "Global".MediaHotWater.InUse := FALSE;
    "Global".MediaHotWater.UsingZone := 0;
    "Global".MediaPureWater.InUse := FALSE;
    "Global".MediaPureWater.UsingZone := 0;

    // 初始化罐区状态
    "FC_InitTankData"(1);
    "FC_InitTankData"(2);
    "FC_InitTankData"(3);
    "FC_InitTankData"(4);

    // 初始化报警
    "Global".AlarmCount := 0;

END_FUNCTION


// ============================================================================
// FC_InitZoneData : 初始化区域数据
// ============================================================================
FUNCTION "FC_InitZoneData" : Void
TITLE = "初始化区域数据"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_INPUT
    ZoneID : Int;
END_VAR

    "DB_Zone"[ZoneID].ZoneID := ZoneID;
    "DB_Zone"[ZoneID].State := "Enum_CleanState".IDLE;
    "DB_Zone"[ZoneID].PreviousState := "Enum_CleanState".IDLE;
    "DB_Zone"[ZoneID].CurrentStep := 0;
    "DB_Zone"[ZoneID].StepTimer := 0;
    "DB_Zone"[ZoneID].Result := FALSE;
    "DB_Zone"[ZoneID].CurrentMedia := "Enum_MediaType".PURE_WATER;
    "DB_Zone"[ZoneID].TempControl := FALSE;
    "DB_Zone"[ZoneID].TempSP := 0;
    "DB_Zone"[ZoneID].TempReached := FALSE;
    "DB_Zone"[ZoneID].InsertedStep := FALSE;
    "DB_Zone"[ZoneID].NoFlowTimer := 0;
    "DB_Zone"[ZoneID].LowTempTimer := 0;

    // 传感器数据初始化
    "DB_Zone"[ZoneID].TT_Outlet := 0;
    "DB_Zone"[ZoneID].TT_Return := 0;
    "DB_Zone"[ZoneID].CD := 0;
    "DB_Zone"[ZoneID].PT := 0;
    "DB_Zone"[ZoneID].FT := 0;
    "DB_Zone"[ZoneID].FS := FALSE;

    // 设备状态初始化
    "DB_Zone"[ZoneID].PumpState := "Enum_PumpState".PUMP_STOP;
    "DB_Zone"[ZoneID].ValveState := "Enum_ValveState".VALVE_CLOSED;

END_FUNCTION


// ============================================================================
// FC_InitRecipeData : 初始化配方数据
// ============================================================================
FUNCTION "FC_InitRecipeData" : Void
TITLE = "初始化配方数据"
AUTHOR : "SCADA"
VERSION : "1.0"

    // 配方1: 纯水冲洗
    "Global".RecipeList[1].RecipeID := 1;
    "Global".RecipeList[1].RecipeName := 'PureWaterRinse';
    "Global".RecipeList[1].StepCount := 1;
    "Global".RecipeList[1].Steps[1].MediaID := "Enum_MediaType".PURE_WATER;
    "Global".RecipeList[1].Steps[1].MediaName := '纯水冲洗';
    "Global".RecipeList[1].Steps[1].TargetTemp := 25;
    "Global".RecipeList[1].Steps[1].TargetTime := 600;
    "Global".RecipeList[1].Steps[1].TargetFlow := 3.0;
    "Global".RecipeList[1].Enable := TRUE;

    // 配方2: 热水冲洗
    "Global".RecipeList[2].RecipeID := 2;
    "Global".RecipeList[2].RecipeName := 'HotWaterRinse';
    "Global".RecipeList[2].StepCount := 1;
    "Global".RecipeList[2].Steps[1].MediaID := "Enum_MediaType".HOT_WATER;
    "Global".RecipeList[2].Steps[1].MediaName := '热水冲洗';
    "Global".RecipeList[2].Steps[1].TargetTemp := 85;
    "Global".RecipeList[2].Steps[1].TargetTime := 600;
    "Global".RecipeList[2].Steps[1].TargetFlow := 3.0;
    "Global".RecipeList[2].Enable := TRUE;

    // 配方3: 碱洗+冲洗 (3步)
    "Global".RecipeList[3].RecipeID := 3;
    "Global".RecipeList[3].RecipeName := 'AlkaliRinse';
    "Global".RecipeList[3].StepCount := 3;
    "Global".RecipeList[3].Steps[1].MediaID := "Enum_MediaType".PURE_WATER;
    "Global".RecipeList[3].Steps[1].MediaName := '纯水冲洗';
    "Global".RecipeList[3].Steps[1].TargetTemp := 85;
    "Global".RecipeList[3].Steps[1].TargetTime := 900;
    "Global".RecipeList[3].Steps[1].TargetFlow := 3.0;
    "Global".RecipeList[3].Steps[2].MediaID := "Enum_MediaType".ALKALI;
    "Global".RecipeList[3].Steps[2].MediaName := '碱洗';
    "Global".RecipeList[3].Steps[2].TargetTemp := 85;
    "Global".RecipeList[3].Steps[2].TargetTime := 1500;
    "Global".RecipeList[3].Steps[2].TargetFlow := 5.0;
    "Global".RecipeList[3].Steps[3].MediaID := "Enum_MediaType".PURE_WATER;
    "Global".RecipeList[3].Steps[3].MediaName := '纯水冲洗';
    "Global".RecipeList[3].Steps[3].TargetTemp := 25;
    "Global".RecipeList[3].Steps[3].TargetTime := 600;
    "Global".RecipeList[3].Steps[3].TargetFlow := 3.0;
    "Global".RecipeList[3].Enable := TRUE;

    // 配方4: 酸洗+冲洗 (3步)
    "Global".RecipeList[4].RecipeID := 4;
    "Global".RecipeList[4].RecipeName := 'AcidRinse';
    "Global".RecipeList[4].StepCount := 3;
    "Global".RecipeList[4].Steps[1].MediaID := "Enum_MediaType".PURE_WATER;
    "Global".RecipeList[4].Steps[1].MediaName := '纯水冲洗';
