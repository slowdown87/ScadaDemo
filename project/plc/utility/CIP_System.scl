    "Global".RecipeList[5].Steps[5].MediaID := "Enum_MediaType".PURE_WATER;
    "Global".RecipeList[5].Steps[5].MediaName := '纯水冲洗';
    "Global".RecipeList[5].Steps[5].TargetTemp := 25;
