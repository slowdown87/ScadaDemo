    "Global".RecipeList[4].Steps[1].TargetTime := 600;
    "Global".RecipeList[4].Steps[1].TargetFlow := 3.0;
    "Global".RecipeList[4].Steps[2].MediaID := "Enum_MediaType".ACID;
    "Global".RecipeList[4].Steps[2].MediaName := '酸洗';
    "Global".RecipeList[4].Steps[2].TargetTemp := 60;
    "Global".RecipeList[4].Steps[2].TargetTime := 1200;
    "Global".RecipeList[4].Steps[2].TargetFlow := 5.0;
    "Global".RecipeList[4].Steps[3].MediaID := "Enum_MediaType".PURE_WATER;
    "Global".RecipeList[4].Steps[3].MediaName := '纯水冲洗';
    "Global".RecipeList[4].Steps[3].TargetTemp := 25;
    "Global".RecipeList[4].Steps[3].TargetTime := 600;
    "Global".RecipeList[4].Steps[3].TargetFlow := 3.0;
    "Global".RecipeList[4].Enable := TRUE;

    // 配方5: 碱洗+酸洗+冲洗 (5步)
