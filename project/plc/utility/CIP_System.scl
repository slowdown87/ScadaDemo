// ============================================================================
// FC_InitTankData : 初始化罐区数据
// ============================================================================
FUNCTION "FC_InitTankData" : Void
TITLE = "初始化罐区数据"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_INPUT
    TankID : Int;
END_VAR
VAR
    TankData : "UDT_TankStatus";
END_VAR

    CASE TankID OF
        1:  // 碱液罐
            TankData.LevelMin := 20.0;
            TankData.LevelMax := 95.0;
            TankData.TempMin := 60.0;
            TankData.TempMax := 90.0;
            TankData.TempSP := 85.0;
            TankData.TargetConc := 2.0;
            TankData.Ready := TRUE;

        2:  // 酸液罐
            TankData.LevelMin := 20.0;
            TankData.LevelMax := 95.0;
            TankData.TempMin := 50.0;
            TankData.TempMax := 70.0;
            TankData.TempSP := 60.0;
            TankData.TargetConc := 1.0;
            TankData.Ready := TRUE;

        3:  // 热水罐
            TankData.LevelMin := 20.0;
            TankData.LevelMax := 95.0;
            TankData.TempMin := 75.0;
            TankData.TempMax := 90.0;
            TankData.TempSP := 85.0;
            TankData.Ready := TRUE;

        4:  // 纯水罐
            TankData.LevelMin := 20.0;
            TankData.LevelMax := 95.0;
            TankData.TempMin := 20.0;
            TankData.TempMax := 30.0;
            TankData.TempSP := 25.0;
            TankData.Ready := TRUE;
    END_CASE;

    CASE TankID OF
        1: "Global".TankAlkali := TankData;
        2: "Global".TankAcid := TankData;
        3: "Global".TankHotWater := TankData;
        4: "Global".TankPureWater := TankData;
    END_CASE;

END_FUNCTION


// ============================================================================
// FC_ManageMediaResources : 介质资源管理
// ============================================================================
FUNCTION "FC_ManageMediaResources" : Void
TITLE = "介质资源管理"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_TEMP
    i : Int;
END_VAR

    FOR i := 1 TO 5 DO
        IF "DB_Zone"[i].State = "Enum_CleanState".STEP_TRANSITION THEN
            // 在步骤切换时申请下一步介质
        END_IF;
    END_FOR;

END_FUNCTION


// ============================================================================
// FC_RequestMedia : 请求介质资源
// ============================================================================
FUNCTION "FC_RequestMedia" : Bool
TITLE = "请求介质资源"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_INPUT
    ZoneID : Int;
    MediaID : "Enum_MediaType";
END_VAR
VAR
    MediaPtr : Int;
END_VAR

    "FC_RequestMedia" := FALSE;

    // 纯水不需要独占，可以被多区同时使用
    IF MediaID = "Enum_MediaType".PURE_WATER THEN
        "FC_RequestMedia" := TRUE;
        RETURN;
    END_IF;

    // 获取介质指针
    CASE MediaID OF
        "Enum_MediaType".ALKALI:  MediaPtr := 1;
        "Enum_MediaType".ACID:    MediaPtr := 2;
        "Enum_MediaType".HOT_WATER: MediaPtr := 3;
        "Enum_MediaType".DISINFECT: MediaPtr := 4;
    ELSE
        RETURN;
    END_CASE;

    // 检查介质是否已被占用
    CASE MediaPtr OF
        1:
            IF NOT "Global".MediaAlkali.InUse THEN
                "Global".MediaAlkali.InUse := TRUE;
                "Global".MediaAlkali.UsingZone := ZoneID;
                "FC_RequestMedia" := TRUE;
            END_IF;
        2:
            IF NOT "Global".MediaAcid.InUse THEN
                "Global".MediaAcid.InUse := TRUE;
                "Global".MediaAcid.UsingZone := ZoneID;
                "FC_RequestMedia" := TRUE;
            END_IF;
        3:
            IF NOT "Global".MediaHotWater.InUse THEN
                "Global".MediaHotWater.InUse := TRUE;
                "Global".MediaHotWater.UsingZone := ZoneID;
                "FC_RequestMedia" := TRUE;
            END_IF;
        4:
            IF NOT "Global".MediaDisinfect.InUse THEN
                "Global".MediaDisinfect.InUse := TRUE;
                "Global".MediaDisinfect.UsingZone := ZoneID;
                "FC_RequestMedia" := TRUE;
            END_IF;
    END_CASE;

END_FUNCTION


// ============================================================================
// FC_ReleaseAllMedia : 释放区域占用的所有介质资源
// ============================================================================
FUNCTION "FC_ReleaseAllMedia" : Void
TITLE = "释放所有介质资源"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_INPUT
    ZoneID : Int;
END_VAR

    IF "Global".MediaAlkali.UsingZone = ZoneID THEN
        "Global".MediaAlkali.InUse := FALSE;
        "Global".MediaAlkali.UsingZone := 0;
    END_IF;

    IF "Global".MediaAcid.UsingZone = ZoneID THEN
        "Global".MediaAcid.InUse := FALSE;
        "Global".MediaAcid.UsingZone := 0;
    END_IF;

    IF "Global".MediaHotWater.UsingZone = ZoneID THEN
        "Global".MediaHotWater.InUse := FALSE;
        "Global".MediaHotWater.UsingZone := 0;
    END_IF;

    IF "Global".MediaDisinfect.UsingZone = ZoneID THEN
        "Global".MediaDisinfect.InUse := FALSE;
        "Global".MediaDisinfect.UsingZone := 0;
    END_IF;

    // 关闭所有介质阀门
    "Global".Valve.Alkali := FALSE;
    "Global".Valve.Acid := FALSE;
    "Global".Valve.HotWater := FALSE;
    "Global".Valve.PureWater := FALSE;
    "Global".Valve.Disinfect := FALSE;

END_FUNCTION


// ============================================================================
// FC_UpdateZoneData : 更新区域数据
// ============================================================================
FUNCTION "FC_UpdateZoneData" : Void
TITLE = "更新区域数据"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_INPUT
    ZoneID : Int;
END_VAR

    IF ZoneID < 1 OR ZoneID > 5 THEN
        RETURN;
    END_IF;

    // 更新泵状态
    IF "DB_Zone"[ZoneID].PumpCmd THEN
        "DB_Zone"[ZoneID].PumpState := "Enum_PumpState".PUMP_RUN;
    ELSE
        "DB_Zone"[ZoneID].PumpState := "Enum_PumpState".PUMP_STOP;
    END_IF;

    // 更新阀门状态
    IF "Global".Valve.Alkali OR "Global".Valve.Acid OR "Global".Valve.HotWater
        OR "Global".Valve.PureWater OR "Global".Valve.Disinfect THEN
        "DB_Zone"[ZoneID].ValveState := "Enum_ValveState".VALVE_OPEN;
    ELSE
        "DB_Zone"[ZoneID].ValveState := "Enum_ValveState".VALVE_CLOSED;
    END_IF;

END_FUNCTION


// ============================================================================
// FC_UpdateSystemStatus : 更新系统状态
// ============================================================================
FUNCTION "FC_UpdateSystemStatus" : Void
TITLE = "更新系统状态"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_TEMP
    i : Int;
    IdleCount : Int;
    RunningCount : Int;
END_VAR

    IdleCount := 0;
    RunningCount := 0;

    FOR i := 1 TO 5 DO
        IF "DB_Zone"[i].State = "Enum_CleanState".IDLE THEN
            IdleCount := IdleCount + 1;
        ELSIF "DB_Zone"[i].State = "Enum_CleanState".STEP_EXEC
            OR "DB_Zone"[i].State = "Enum_CleanState".STEP_TRANSITION
            OR "DB_Zone"[i].State = "Enum_CleanState".READY THEN
            RunningCount := RunningCount + 1;
        END_IF;
    END_FOR;

    "Global".System.AllIdle := (IdleCount = 5);
    "Global".System.Running := (RunningCount > 0);
    "Global".System.ActiveZones := RunningCount;
    "Global".System.SystemTime := LDT#2026-01-01-00:00:00;

END_FUNCTION


// ============================================================================
// FC_UpdateSecondTimers : 秒级计时更新
// ============================================================================
FUNCTION "FC_UpdateSecondTimers" : Void
TITLE = "秒级计时更新"
AUTHOR : "SCADA"
VERSION : "1.0"
VAR_TEMP
    i : Int;
END_VAR

    FOR i := 1 TO 5 DO
        // 步骤计时
        IF "DB_Zone"[i].State = "Enum_CleanState".STEP_EXEC THEN
            "DB_Zone"[i].StepTimer := "DB_Zone"[i].StepTimer + 1;
        END_IF;

        // 无流量计时
        IF NOT "DB_Zone"[i].FS AND "DB_Zone"[i].State = "Enum_CleanState".STEP_EXEC THEN
            "DB_Zone"[i].NoFlowTimer := "DB_Zone"[i].NoFlowTimer + 1;
        ELSE
            "DB_Zone"[i].NoFlowTimer := 0;
        END_IF;

        // 低温计时
        IF "DB_Zone"[i].TempControl
        AND NOT "DB_Zone"[i].TempReached
        AND "DB_Zone"[i].State = "Enum_CleanState".STEP_EXEC THEN
            "DB_Zone"[i].LowTempTimer := "DB_Zone"[i].LowTempTimer + 1;
        ELSE
            "DB_Zone"[i].LowTempTimer := 0;
        END_IF;

        // 超时计时
        IF "DB_Zone"[i].State = "Enum_CleanState".STEP_EXEC THEN
            "DB_Zone"[i].OverTimeTimer := "DB_Zone"[i].OverTimeTimer + 1;
        END_IF;
    END_FOR;

END_FUNCTION
