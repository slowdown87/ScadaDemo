    "Global".RecipeList[5].Steps[2].MediaName := '碱洗';
    "Global".RecipeList[5].Steps[2].TargetTemp := 85;
    "Global".RecipeList[5].Steps[2].TargetTime := 1500;
    "Global".RecipeList[5].Steps[2].TargetFlow := 5.0;
    "Global".RecipeList[5].Steps[3].MediaID := "Enum_MediaType".PURE_WATER;
    "Global".RecipeList[5].Steps[3].MediaName := '纯水冲洗';
    "Global".RecipeList[5].Steps[3].TargetTemp := 70;
    "Global".RecipeList[5].Steps[3].TargetTime := 600;
    "Global".RecipeList[5].Steps[3].TargetFlow := 3.0;
    "Global".RecipeList[5].Steps[4].MediaID := "Enum_MediaType".ACID;
    "Global".RecipeList[5].Steps[4].MediaName := '酸洗';
